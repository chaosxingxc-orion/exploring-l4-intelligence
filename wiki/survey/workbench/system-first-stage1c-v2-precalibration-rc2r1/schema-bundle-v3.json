{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sf-stage1c-v2-schema-bundle-v3",
  "calibration_response_schema_id": "sf-stage1c-v2-calibration-response-schema-v3",
  "specialized_system_branch_gate": "SPECIALIZED_SYSTEM_EXCLUSION_CANNOT_ENTER_CORE_MEMBER_OR_BRANCH_PRIMARY",
  "$defs": {
    "paper_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "paper_disposition",
        "paper_role",
        "source_domain",
        "fulltext_status",
        "source_locator_ids",
        "empirical_experiment_present",
        "agentic_scope_status",
        "agentic_loop_components",
        "core_dependency",
        "capability_assets",
        "control_role",
        "agentic_scope_reason",
        "branch_eligibility",
        "run_cell_ids",
        "load_bearing_status",
        "load_bearing_reason",
        "coder_id",
        "reviewer_id",
        "adjudication_status"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(arxiv|acl):[A-Za-z0-9._:-]+$"
        },
        "paper_disposition": {
          "type": "string",
          "enum": [
            "EMPIRICAL_EXTRACTABLE",
            "NON_EMPIRICAL_EVIDENCE_ONLY",
            "INSUFFICIENT_FULLTEXT",
            "OUT_OF_SCOPE_WITH_REASON"
          ]
        },
        "paper_role": {
          "type": "string",
          "enum": [
            "DIRECT_METHOD",
            "INSTRUMENT",
            "BOUNDARY",
            "NEGATIVE_OR_FALSIFIER",
            "TRANSFER_ANALOGUE",
            "NON_LOAD_BEARING"
          ]
        },
        "source_domain": {
          "type": "string",
          "enum": [
            "SPEECH",
            "OMNI",
            "VISION_MULTIMODAL",
            "TEXT_AGENT",
            "OTHER_TRANSFER"
          ]
        },
        "fulltext_status": {
          "type": "string",
          "enum": [
            "PRIMARY_FULLTEXT_VERIFIED",
            "ALTERNATE_RENDITION_VERIFIED",
            "INSUFFICIENT_OR_BLOCKED"
          ]
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "empirical_experiment_present": {
          "type": "boolean"
        },
        "agentic_scope_status": {
          "type": "string",
          "enum": [
            "DIRECT_AGENTIC",
            "INSTRUMENT_SUPPORT",
            "TRANSFER_ANALOGUE",
            "REFERENCE_ONLY_BOUNDARY",
            "OUT_OF_SCOPE_SPECIALIZED_SYSTEM"
          ]
        },
        "agentic_loop_components": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "OBSERVE",
              "STATE_OR_MEMORY",
              "DECIDE",
              "ACT_OR_TOOL",
              "EVALUATE",
              "UPDATE_OR_REPAIR",
              "STOP_OR_BUDGET",
              "NONE"
            ]
          },
          "uniqueItems": true
        },
        "core_dependency": {
          "type": "string",
          "enum": [
            "GENERIC_FROZEN_CORE",
            "SPECIALIZED_MODEL_REQUIRED",
            "TRAINED_CONTROLLER_REQUIRED",
            "MIXED_OR_UNCLEAR"
          ]
        },
        "capability_assets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "KNOWLEDGE",
              "SKILL",
              "MEMORY",
              "NONE"
            ]
          },
          "uniqueItems": true
        },
        "control_role": {
          "type": "string",
          "enum": [
            "TRAINING_FREE_REWARD_GUIDED",
            "TRAINING_FREE_NON_REWARD_AGENTIC",
            "TRAINED_CONTROL",
            "INSTRUMENT_ONLY",
            "NONE"
          ]
        },
        "agentic_scope_reason": {
          "type": "string",
          "minLength": 1
        },
        "branch_eligibility": {
          "type": "string",
          "enum": [
            "ELIGIBLE_FOR_FAMILY_REVIEW",
            "REFERENCE_ONLY",
            "INELIGIBLE_SPECIALIZED_SYSTEM",
            "INELIGIBLE_TRAINED_CONTROLLER"
          ]
        },
        "run_cell_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^RC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true
        },
        "load_bearing_status": {
          "type": "string",
          "enum": [
            "LOAD_BEARING",
            "RELATION_EVIDENCE",
            "NON_LOAD_BEARING"
          ]
        },
        "load_bearing_reason": {
          "type": "string",
          "minLength": 1
        },
        "coder_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "adjudication_status": {
          "type": "string",
          "enum": [
            "NOT_REQUIRED",
            "PENDING",
            "ADJUDICATED_ACCEPTED",
            "ADJUDICATED_REVISED"
          ]
        }
      }
    },
    "run_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_cell_id",
        "paper_id",
        "dataset_node_ids",
        "model",
        "access_regime",
        "input_condition",
        "intervention",
        "primary_intervention_axis",
        "control_signal",
        "decision_or_action",
        "budget_horizon",
        "baseline_role",
        "source_locator_ids"
      ],
      "properties": {
        "run_cell_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC-[A-Za-z0-9._:-]+$"
        },
        "paper_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(arxiv|acl):[A-Za-z0-9._:-]+$"
        },
        "dataset_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^DS-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "access_regime": {
          "type": "string",
          "enum": [
            "TF_STRICT_BLACK_BOX",
            "TF_STRICT_GRAY_BOX",
            "TRAINED_PARAMETER_UPDATE",
            "INSTRUMENT_ONLY",
            "MIXED_OR_UNCLEAR"
          ]
        },
        "input_condition": {
          "type": "string",
          "minLength": 1
        },
        "intervention": {
          "type": "string",
          "minLength": 1
        },
        "primary_intervention_axis": {
          "type": "string",
          "enum": [
            "D0_SYSTEM_HARNESS",
            "D1_MULTIMODAL_KNOWLEDGE",
            "D2_MULTIMODAL_SKILL",
            "D3_MULTIMODAL_MEMORY",
            "D4_TF_RL_ORCHESTRATION",
            "NOT_APPLICABLE"
          ]
        },
        "control_signal": {
          "type": "string",
          "minLength": 1
        },
        "decision_or_action": {
          "type": "string",
          "minLength": 1
        },
        "budget_horizon": {
          "type": "string",
          "minLength": 1
        },
        "baseline_role": {
          "type": "string",
          "enum": [
            "BASELINE",
            "INTERVENTION",
            "ABLATION",
            "ORACLE_OR_UPPER_BOUND",
            "OTHER"
          ]
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "run_cell_id",
        "metric_or_evaluator",
        "outcome_semantics",
        "raw_result",
        "observation_role",
        "source_locator_ids"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^OBS-[A-Za-z0-9._:-]+$"
        },
        "run_cell_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC-[A-Za-z0-9._:-]+$"
        },
        "metric_or_evaluator": {
          "type": "string",
          "minLength": 1
        },
        "outcome_semantics": {
          "type": "string",
          "minLength": 1
        },
        "raw_result": {
          "type": "string",
          "minLength": 1
        },
        "observation_role": {
          "type": "string",
          "enum": [
            "PRIMARY_OUTCOME",
            "SECONDARY_OUTCOME",
            "COST_LATENCY",
            "DIAGNOSTIC"
          ]
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "paired_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "baseline_cell_id",
        "intervention_cell_id",
        "paired_status",
        "comparability_key",
        "source_locator_ids"
      ],
      "properties": {
        "comparison_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^PC-[A-Za-z0-9._:-]+$"
        },
        "baseline_cell_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC-[A-Za-z0-9._:-]+$"
        },
        "intervention_cell_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC-[A-Za-z0-9._:-]+$"
        },
        "paired_status": {
          "type": "string",
          "enum": [
            "EXACT_PAIRED",
            "PARTIAL_PAIRED",
            "UNPAIRED",
            "NOT_COMPARABLE"
          ]
        },
        "comparability_key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_revision_split",
            "core_model",
            "access",
            "input_condition",
            "metric",
            "budget_horizon"
          ],
          "properties": {
            "dataset_revision_split": {
              "type": "string",
              "minLength": 1
            },
            "core_model": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "type": "string",
              "minLength": 1
            },
            "input_condition": {
              "type": "string",
              "minLength": 1
            },
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "budget_horizon": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "dataset_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "name",
        "revision",
        "split",
        "source_locator_ids"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DS-[A-Za-z0-9._:-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "dataset_lineage_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_dataset_id",
        "relation",
        "target_dataset_id",
        "source_locator_ids"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DL-[A-Za-z0-9._:-]+$"
        },
        "source_dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DS-[A-Za-z0-9._:-]+$"
        },
        "relation": {
          "type": "string",
          "enum": [
            "SAME_REVISION",
            "DERIVED_FROM",
            "SUBSET_OF",
            "TRANSLATED_FROM",
            "AUDIO_RENDERING_OF",
            "REANNOTATED_FROM",
            "SPLIT_OF"
          ]
        },
        "target_dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DS-[A-Za-z0-9._:-]+$"
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "dataset_relation_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_dataset_id",
        "relation",
        "target_dataset_id",
        "reason",
        "source_locator_ids"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DR-[A-Za-z0-9._:-]+$"
        },
        "source_dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DS-[A-Za-z0-9._:-]+$"
        },
        "relation": {
          "type": "string",
          "enum": [
            "INDEPENDENT_SAME_TASK",
            "CROSS_DATASET_VALIDATION",
            "DISTRIBUTION_SHIFT_TEST",
            "PROTOCOL_ANALOGUE"
          ]
        },
        "target_dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DS-[A-Za-z0-9._:-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "claim_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "object_type",
        "claim_text",
        "claim_origin",
        "scope",
        "evidence_relation",
        "evidence_state",
        "project_status",
        "source_locator_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^CLM-[A-Za-z0-9._:-]+$"
        },
        "object_type": {
          "type": "string",
          "enum": [
            "SCOPED_CLAIM_INSTANCE"
          ]
        },
        "claim_text": {
          "type": "string",
          "minLength": 1
        },
        "claim_origin": {
          "type": "string",
          "enum": [
            "PAPER_STATED",
            "FAMILY_SYNTHESIS",
            "BOUNDARY_OR_FALSIFIER",
            "MEASUREMENT_CONTRACT"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "problem_outcome",
            "task",
            "dataset_revision_split",
            "model",
            "access",
            "input_condition",
            "intervention",
            "budget_horizon",
            "evaluator"
          ],
          "properties": {
            "problem_outcome": {
              "type": "string",
              "minLength": 1
            },
            "task": {
              "type": "string",
              "minLength": 1
            },
            "dataset_revision_split": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "type": "string",
              "minLength": 1
            },
            "input_condition": {
              "type": "string",
              "minLength": 1
            },
            "intervention": {
              "type": "string",
              "minLength": 1
            },
            "budget_horizon": {
              "type": "string",
              "minLength": 1
            },
            "evaluator": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidence_relation": {
          "type": "string",
          "enum": [
            "SUPPORT",
            "BOUNDARY",
            "FALSIFIER",
            "INSTRUMENT_SUPPORT",
            "TRANSFER_ANALOGUE"
          ]
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "DIRECTLY_SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "project_status": {
          "type": "string",
          "enum": [
            "PAPER_CLAIM_ONLY",
            "RESIDUAL_HYPOTHESIS_NOT_NOVELTY_VERDICT"
          ]
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "family_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "problem_statement",
        "protocol_signature",
        "evidence_state",
        "strongest_contradiction",
        "uncertainty",
        "residual_hypothesis",
        "alternative_explanation",
        "kill_criterion",
        "local_readiness",
        "h5_status"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^FAM-[A-Za-z0-9._:-]+$"
        },
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "protocol_signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_problem_or_failure",
            "evaluation_object",
            "outcome_semantics",
            "environment",
            "interaction_protocol",
            "access_protocol",
            "baseline_intervention_interpretable"
          ],
          "properties": {
            "target_problem_or_failure": {
              "type": "string",
              "minLength": 1
            },
            "evaluation_object": {
              "type": "string",
              "minLength": 1
            },
            "outcome_semantics": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "string",
              "minLength": 1
            },
            "interaction_protocol": {
              "type": "string",
              "minLength": 1
            },
            "access_protocol": {
              "type": "string",
              "enum": [
                "TF_STRICT_BLACK_BOX",
                "TF_STRICT_GRAY_BOX",
                "TRAINED_PARAMETER_UPDATE",
                "INSTRUMENT_ONLY",
                "MIXED_OR_UNCLEAR"
              ]
            },
            "baseline_intervention_interpretable": {
              "type": "boolean"
            }
          }
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "CONSISTENT_SUPPORT",
            "MIXED",
            "NULL_OR_NEGATIVE",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "strongest_contradiction": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "residual_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "alternative_explanation": {
          "type": "string",
          "minLength": 1
        },
        "kill_criterion": {
          "type": "string",
          "minLength": 1
        },
        "local_readiness": {
          "type": "string",
          "enum": [
            "LOCAL_READY",
            "LOCAL_ADAPTABLE",
            "BLOCKED_ASSET_OR_TERMS",
            "TRANSFER_ONLY"
          ]
        },
        "h5_status": {
          "type": "string",
          "enum": [
            "NOT_H5_DEPENDENT",
            "H5_DEPENDENT_WITHHELD",
            "H5_CLOSED_EVIDENCE_BOUND"
          ]
        }
      }
    },
    "family_membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_id",
        "family_id",
        "evidence_object_id",
        "membership_type",
        "compatibility_decision",
        "compatibility_reason",
        "review_status"
      ],
      "properties": {
        "membership_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^FM-[A-Za-z0-9._:-]+$"
        },
        "family_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^FAM-[A-Za-z0-9._:-]+$"
        },
        "evidence_object_id": {
          "type": "string",
          "minLength": 1
        },
        "membership_type": {
          "type": "string",
          "enum": [
            "CORE_MEMBER",
            "VALIDATION_MEMBER",
            "TRANSFER_ANALOGUE",
            "FALSIFIER",
            "INSTRUMENT_SUPPORT"
          ]
        },
        "compatibility_decision": {
          "type": "string",
          "enum": [
            "COMPATIBLE",
            "INCOMPATIBLE_RELATION_ONLY",
            "WITHHELD_PENDING_ADJUDICATION"
          ]
        },
        "compatibility_reason": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "type": "string",
          "enum": [
            "PENDING_REVIEW",
            "REVIEWED_ACCEPTED",
            "ADJUDICATED"
          ]
        }
      }
    },
    "review_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "object_id",
        "actor_id",
        "event_type",
        "timestamp",
        "prior_event_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^REV-[A-Za-z0-9._:-]+$"
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "enum": [
            "CODER_SUBMISSION",
            "BLIND_REVIEW",
            "ADJUDICATION",
            "CORRECTION"
          ]
        },
        "timestamp": {
          "type": "string",
