{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sf-stage1c-v2-calibration-response-schema-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "response_status",
    "response_id",
    "paper_id",
    "packet_item_id",
    "source_manifest_id",
    "coder_transaction_id",
    "coder_id",
    "paper_labels",
    "run_cells",
    "observations",
    "paired_comparisons",
    "dataset_nodes",
    "dataset_edges",
    "claim_decisions",
    "translation_or_compatibility_decisions",
    "source_locators",
    "object_absence_reasons",
    "review_events",
    "notes",
    "protocol_transfer_evidence",
    "reproduction_evidence"
  ],
  "properties": {
    "schema": {
      "const": "sf-stage1c-v2-calibration-response-v3"
    },
    "response_status": {
      "type": "string",
      "enum": [
        "BLANK_NOT_DISTRIBUTED",
        "CODER_SUBMITTED"
      ]
    },
    "response_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_item_id": {
      "type": "string",
      "minLength": 1
    },
    "source_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "coder_transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "coder_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_labels": {
      "$ref": "#/$defs/paper_labels"
    },
    "run_cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run_cell"
      },
      "uniqueItems": true
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "uniqueItems": true
    },
    "paired_comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paired_comparison"
      },
      "uniqueItems": true
    },
    "dataset_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset_node"
      },
      "uniqueItems": true
    },
    "dataset_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset_edge"
      },
      "uniqueItems": true
    },
    "claim_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_decision"
      },
      "uniqueItems": true
    },
    "translation_or_compatibility_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibility_decision"
      },
      "uniqueItems": true
    },
    "source_locators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_locator"
      },
      "uniqueItems": true
    },
    "object_absence_reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_cells",
        "observations",
        "paired_comparisons",
        "dataset_nodes",
        "dataset_edges",
        "claim_decisions",
        "translation_or_compatibility_decisions"
      ],
      "properties": {
        "run_cells": {
          "type": "string",
          "enum": [
            "OBJECTS_PRESENT",
            "NONE_REPORTED",
            "NOT_APPLICABLE_NON_EMPIRICAL",
            "WITHHELD_INSUFFICIENT_SOURCE",
            "NOT_CODED"
          ]
        },
        "observations": {
          "type": "string",
          "enum": [
            "OBJECTS_PRESENT",
            "NONE_REPORTED",
            "NOT_APPLICABLE_NON_EMPIRICAL",
            "WITHHELD_INSUFFICIENT_SOURCE",
            "NOT_CODED"
          ]
        },
        "paired_comparisons": {
          "type": "string",
          "enum": [
            "OBJECTS_PRESENT",
            "NONE_REPORTED",
            "NOT_APPLICABLE_NON_EMPIRICAL",
            "WITHHELD_INSUFFICIENT_SOURCE",
            "NOT_CODED"
          ]
        },
        "dataset_nodes": {
          "type": "string",
          "enum": [
            "OBJECTS_PRESENT",
            "NONE_REPORTED",
            "NOT_APPLICABLE_NON_EMPIRICAL",
            "WITHHELD_INSUFFICIENT_SOURCE",
            "NOT_CODED"
          ]
        },
        "dataset_edges": {
          "type": "string",
          "enum": [
            "OBJECTS_PRESENT",
            "NONE_REPORTED",
            "NOT_APPLICABLE_NON_EMPIRICAL",
            "WITHHELD_INSUFFICIENT_SOURCE",
            "NOT_CODED"
          ]
        },
        "claim_decisions": {
          "type": "string",
          "enum": [
            "OBJECTS_PRESENT",
            "NONE_REPORTED",
            "NOT_APPLICABLE_NON_EMPIRICAL",
            "WITHHELD_INSUFFICIENT_SOURCE",
            "NOT_CODED"
          ]
        },
        "translation_or_compatibility_decisions": {
          "type": "string",
          "enum": [
            "OBJECTS_PRESENT",
            "NONE_REPORTED",
            "NOT_APPLICABLE_NON_EMPIRICAL",
            "WITHHELD_INSUFFICIENT_SOURCE",
            "NOT_CODED"
          ]
        }
      }
    },
    "review_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_event"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "protocol_transfer_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/protocol_transfer_evidence"
      },
      "uniqueItems": true
    },
    "reproduction_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reproduction_evidence"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "paper_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_disposition",
        "paper_role",
        "problem_nodes",
        "intervention_axes",
        "mm_level",
        "reference_borrow_reproduce",
        "access_regime",
        "empirical_experiment_present",
        "agentic_scope"
      ],
      "properties": {
        "paper_disposition": {
          "type": "string",
          "enum": [
            "EMPIRICAL_EXTRACTABLE",
            "NON_EMPIRICAL_EVIDENCE_ONLY",
            "INSUFFICIENT_FULLTEXT",
            "OUT_OF_SCOPE_WITH_REASON",
            "NOT_CODED"
          ]
        },
        "paper_role": {
          "type": "string",
          "enum": [
            "DIRECT_METHOD",
            "INSTRUMENT",
            "BOUNDARY",
            "NEGATIVE_OR_FALSIFIER",
            "TRANSFER_ANALOGUE",
            "NON_LOAD_BEARING",
            "NOT_CODED"
          ]
        },
        "problem_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BUDGET_STOP_REPAIR",
              "EVALUATOR_REWARD_RELIABILITY",
              "ACTIVE_MULTIMODAL_EVIDENCE_ACQUISITION_UNDER_BUDGET",
              "SKILL_ACCESS_MAINTENANCE_AND_NEGATIVE_TRANSFER",
              "MEMORY_RETRIEVAL_TO_USE_AND_ACTION_GAP",
              "UNROUTED",
              "NOT_CODED"
            ]
          },
          "uniqueItems": true
        },
        "intervention_axes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "D0_SYSTEM_HARNESS",
              "D1_MULTIMODAL_KNOWLEDGE",
              "D2_MULTIMODAL_SKILL",
              "D3_MULTIMODAL_MEMORY",
              "D4_TF_RL_ORCHESTRATION",
              "NOT_APPLICABLE",
              "NOT_CODED"
            ]
          },
          "uniqueItems": true
        },
        "mm_level": {
          "type": "string",
          "enum": [
            "MM0_TEXT_ONLY",
            "MM1_MULTIMODAL_CONTEXT",
            "MM2_MULTIMODAL_ASSET",
            "MM3_MODALITY_NECESSARY",
            "UNKNOWN",
            "NOT_CODED"
          ]
        },
        "reference_borrow_reproduce": {
          "type": "string",
          "enum": [
            "REFERENCE",
            "BORROW_PROTOCOL",
            "REPRODUCTION_CANDIDATE",
            "NOT_APPLICABLE",
            "NOT_CODED"
          ]
        },
        "access_regime": {
          "type": "string",
          "enum": [
            "TF_STRICT_BLACK_BOX",
            "TF_STRICT_GRAY_BOX",
            "TRAINED_PARAMETER_UPDATE",
            "INSTRUMENT_ONLY",
            "MIXED_OR_UNCLEAR",
            "NOT_CODED"
          ]
        },
        "empirical_experiment_present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "agentic_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_status",
            "loop_components",
            "core_dependency",
            "capability_assets",
            "control_role",
            "scope_reason"
          ],
          "properties": {
            "scope_status": {
              "type": "string",
              "enum": [
                "DIRECT_AGENTIC",
                "INSTRUMENT_SUPPORT",
                "TRANSFER_ANALOGUE",
                "REFERENCE_ONLY_BOUNDARY",
                "OUT_OF_SCOPE_SPECIALIZED_SYSTEM",
                "NOT_CODED"
              ]
            },
            "loop_components": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "OBSERVE",
                  "STATE_OR_MEMORY",
                  "DECIDE",
                  "ACT_OR_TOOL",
                  "EVALUATE",
                  "UPDATE_OR_REPAIR",
                  "STOP_OR_BUDGET",
                  "NONE",
                  "NOT_CODED"
                ]
              },
              "uniqueItems": true
            },
            "core_dependency": {
              "type": "string",
              "enum": [
                "GENERIC_FROZEN_CORE",
                "SPECIALIZED_MODEL_REQUIRED",
                "TRAINED_CONTROLLER_REQUIRED",
                "MIXED_OR_UNCLEAR",
                "NOT_CODED"
              ]
            },
            "capability_assets": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "KNOWLEDGE",
                  "SKILL",
                  "MEMORY",
                  "NONE",
                  "NOT_CODED"
                ]
              },
              "uniqueItems": true
            },
            "control_role": {
              "type": "string",
              "enum": [
                "TRAINING_FREE_REWARD_GUIDED",
                "TRAINING_FREE_NON_REWARD_AGENTIC",
                "TRAINED_CONTROL",
                "INSTRUMENT_ONLY",
                "NONE",
                "NOT_CODED"
              ]
            },
            "scope_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_id",
        "rendition_id",
        "anchor_type",
        "anchor_value",
        "precise_locator"
      ],
      "properties": {
        "locator_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^LOC-[A-Za-z0-9._:-]+$"
        },
        "rendition_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^SRC-[A-Za-z0-9._:-]+$"
        },
        "anchor_type": {
          "type": "string",
          "enum": [
            "PAGE",
            "SECTION",
            "TABLE",
            "FIGURE",
            "APPENDIX",
            "REPOSITORY_FILE"
          ]
        },
        "anchor_value": {
          "type": "string",
          "minLength": 1
        },
        "precise_locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_match_key",
        "run_cell_id",
        "dataset_node_ids",
        "model",
        "access_regime",
        "input_condition",
        "intervention",
        "control_signal",
        "primary_intervention_axis",
        "decision_or_action",
        "budget_horizon",
        "baseline_role",
        "source_locator_ids"
      ],
      "properties": {
        "object_match_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{2,159}$"
        },
        "run_cell_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC-[A-Za-z0-9._:-]+$"
        },
        "dataset_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^DS-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "access_regime": {
          "type": "string",
          "enum": [
            "TF_STRICT_BLACK_BOX",
            "TF_STRICT_GRAY_BOX",
            "TRAINED_PARAMETER_UPDATE",
            "INSTRUMENT_ONLY",
            "MIXED_OR_UNCLEAR"
          ]
        },
        "input_condition": {
          "type": "string",
          "minLength": 1
        },
        "intervention": {
          "type": "string",
          "minLength": 1
        },
        "primary_intervention_axis": {
          "type": "string",
          "enum": [
            "D0_SYSTEM_HARNESS",
            "D1_MULTIMODAL_KNOWLEDGE",
            "D2_MULTIMODAL_SKILL",
            "D3_MULTIMODAL_MEMORY",
            "D4_TF_RL_ORCHESTRATION",
            "NOT_APPLICABLE"
          ]
        },
        "control_signal": {
          "type": "string",
          "minLength": 1
        },
        "decision_or_action": {
          "type": "string",
          "minLength": 1
        },
        "budget_horizon": {
          "type": "string",
          "minLength": 1
        },
        "baseline_role": {
          "type": "string",
          "enum": [
            "BASELINE",
            "INTERVENTION",
            "ABLATION",
            "ORACLE_OR_UPPER_BOUND",
            "OTHER"
          ]
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_match_key",
        "observation_id",
        "run_cell_id",
        "metric_or_evaluator",
        "outcome_semantics",
        "raw_result",
        "observation_role",
        "source_locator_ids"
      ],
      "properties": {
        "object_match_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{2,159}$"
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^OBS-[A-Za-z0-9._:-]+$"
        },
        "run_cell_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC-[A-Za-z0-9._:-]+$"
        },
        "metric_or_evaluator": {
          "type": "string",
          "minLength": 1
        },
        "outcome_semantics": {
          "type": "string",
          "minLength": 1
        },
        "raw_result": {
          "type": "string",
          "minLength": 1
        },
        "observation_role": {
          "type": "string",
          "enum": [
            "PRIMARY_OUTCOME",
            "SECONDARY_OUTCOME",
            "COST_LATENCY",
            "DIAGNOSTIC"
          ]
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "paired_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_match_key",
        "comparison_id",
        "baseline_cell_id",
        "intervention_cell_id",
        "paired_status",
        "comparability_key",
        "source_locator_ids"
      ],
      "properties": {
        "object_match_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{2,159}$"
        },
        "comparison_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^PC-[A-Za-z0-9._:-]+$"
        },
        "baseline_cell_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC-[A-Za-z0-9._:-]+$"
        },
        "intervention_cell_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^RC-[A-Za-z0-9._:-]+$"
        },
        "paired_status": {
          "type": "string",
          "enum": [
            "EXACT_PAIRED",
            "PARTIAL_PAIRED",
            "UNPAIRED",
            "NOT_COMPARABLE"
          ]
        },
        "comparability_key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset_revision_split",
            "core_model",
            "access",
            "input_condition",
            "metric",
            "budget_horizon"
          ],
          "properties": {
            "dataset_revision_split": {
              "type": "string",
              "minLength": 1
            },
            "core_model": {
              "type": "string",
              "minLength": 1
            },
            "access": {
              "type": "string",
              "minLength": 1
            },
            "input_condition": {
              "type": "string",
              "minLength": 1
            },
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "budget_horizon": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "dataset_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_match_key",
        "dataset_node_id",
        "name",
        "revision",
        "split",
        "source_locator_ids"
      ],
      "properties": {
        "object_match_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{2,159}$"
        },
        "dataset_node_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DS-[A-Za-z0-9._:-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "dataset_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_match_key",
        "dataset_edge_id",
        "edge_type",
        "source_dataset_id",
        "relation",
        "target_dataset_id",
        "reason",
        "source_locator_ids"
      ],
      "properties": {
        "object_match_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{2,159}$"
        },
        "dataset_edge_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DE-[A-Za-z0-9._:-]+$"
        },
        "edge_type": {
          "type": "string",
          "enum": [
            "LINEAGE",
            "RELATION"
          ]
        },
        "source_dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DS-[A-Za-z0-9._:-]+$"
        },
        "relation": {
          "type": "string",
          "enum": [
            "SAME_REVISION",
            "DERIVED_FROM",
            "SUBSET_OF",
            "TRANSLATED_FROM",
            "AUDIO_RENDERING_OF",
            "REANNOTATED_FROM",
            "SPLIT_OF",
            "INDEPENDENT_SAME_TASK",
            "CROSS_DATASET_VALIDATION",
            "DISTRIBUTION_SHIFT_TEST",
            "PROTOCOL_ANALOGUE"
          ]
        },
        "target_dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^DS-[A-Za-z0-9._:-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_locator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^LOC-[A-Za-z0-9._:-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "claim_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_match_key",
        "claim_decision_id",
        "claim_template_id",
        "merge_split_decision",
        "scope",
        "evidence_relation",
        "source_locator_ids"
      ],
      "properties": {
        "object_match_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{2,159}$"
        },
        "claim_decision_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^CD-[A-Za-z0-9._:-]+$"
        },
        "claim_template_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^CLM-[A-Z0-9-]+$"
        },
        "merge_split_decision": {
          "type": "string",
          "enum": [
            "CREATE_SCOPED_INSTANCE",
            "LINK_EXISTING_SCOPE_COMPATIBLE_INSTANCE",
            "SPLIT_REQUIRED",
            "NO_LINK",
            "WITHHOLD_UNRESOLVED"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "problem_outcome",
            "task",
            "dataset_revision_split",
            "model",
            "access",
            "input_condition",
            "intervention",
            "budget_horizon",
            "evaluator"
          ],
          "properties": {
            "problem_outcome": {
              "type": "string",
              "minLength": 1
            },
            "task": {
              "type": "string",
              "minLength": 1
            },
            "dataset_revision_split": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
