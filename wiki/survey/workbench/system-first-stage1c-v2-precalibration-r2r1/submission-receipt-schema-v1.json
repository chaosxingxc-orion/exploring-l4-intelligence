{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sf-stage1c-v2-response-submission-receipt-schema-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "coder_slot",
    "coder_id",
    "coder_transaction_id",
    "process_id",
    "task_id",
    "model",
    "delivery_receipt_id",
    "delivery_receipt_sha256",
    "response_schema_id",
    "source_manifest_id",
    "response_count",
    "response_bytes",
    "response_sha256",
    "canonical_paper_ids_sha256",
    "submitted_at",
    "status",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "sf-stage1c-v2-response-submission-receipt-v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^R2R1-SUBMISSION-[AB]-[0-9a-f]{16}$"
    },
    "coder_slot": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "coder_id": {
      "type": "string",
      "minLength": 1
    },
    "coder_transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "process_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "delivery_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "delivery_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "response_schema_id": {
      "const": "sf-stage1c-v2-calibration-response-schema-v6"
    },
    "source_manifest_id": {
      "const": "SF-STAGE1C-V2-CALIBRATION-SOURCE-BYTES-56-RC2R2"
    },
    "response_count": {
      "const": 56
    },
    "response_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_paper_ids_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "FROZEN_SUBMITTED"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
