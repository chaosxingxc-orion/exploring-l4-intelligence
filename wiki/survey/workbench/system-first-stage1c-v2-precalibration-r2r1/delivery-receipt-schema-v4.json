{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sf-stage1c-v2-delivery-receipt-schema-v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "coder_slot",
    "coder_id",
    "coder_transaction_id",
    "process_id",
    "task_id",
    "model",
    "distribution_manifest_id",
    "received_content_bundle_sha256",
    "received_prompt_sha256",
    "received_artifacts",
    "delivered_at",
    "submitted_at",
    "status",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "sf-stage1c-v2-delivery-receipt-v3"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^R2R1-DELIVERY-[AB]-[A-Za-z0-9._:-]+-[A-Za-z0-9._:-]+$"
    },
    "coder_slot": {
      "enum": [
        "A",
        "B"
      ]
    },
    "coder_id": {
      "type": "string",
      "minLength": 1
    },
    "coder_transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "process_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "enum": [
        "gpt-5.6-sol",
        "gpt-5.6-terra"
      ]
    },
    "distribution_manifest_id": {
      "const": "SF-STAGE1C-V2-CALIBRATION-DISTRIBUTION-R2R1"
    },
    "received_content_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "received_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "received_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_name",
          "bytes",
          "sha256"
        ],
        "properties": {
          "artifact_name": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 8,
      "maxItems": 8
    },
    "delivered_at": {
      "type": "string",
      "minLength": 1
    },
    "submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "FROZEN_SUBMITTED"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
